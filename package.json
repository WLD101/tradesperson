{
  "name": "tradesperson-net-erp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @tradesperson/db prisma:generate",
    "db:migrate": "pnpm --filter @tradesperson/db prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @tradesperson/db prisma:migrate:deploy",
    "db:seed": "pnpm --filter @tradesperson/db prisma:seed",
    "db:studio": "pnpm --filter @tradesperson/db prisma:studio",
    "db:validate": "pnpm --filter @tradesperson/db prisma:validate",
    "db:format": "pnpm --filter @tradesperson/db prisma:format"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
