  purchaseRequisitionLine   PurchaseRequisitionLine? @relation(fields: [purchaseRequisitionLineId], references: [id], onDelete: SetNull)
  product                   Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant            ProductVariant?          @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  supplierProduct           SupplierProduct?         @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)

  @@index([tenantId, purchaseOrderVersionId, displayOrder])
  @@index([purchaseRequisitionLineId])
  @@index([tenantId, productId])
  @@index([productVariantId])
  @@index([supplierProductId])
}

model SupplierAcknowledgement {
  id                     String                        @id @default(uuid()) @db.Uuid
  tenantId               String                        @db.Uuid
  purchaseOrderId        String                        @db.Uuid
  purchaseOrderVersionId String?                       @db.Uuid
  status                 SupplierAcknowledgementStatus @default(PENDING)
  supplierReference      String?
  acknowledgedAt         DateTime?
  expectedDeliveryDate   DateTime?
  notes                  String?
  createdById            String?                       @db.Uuid
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  tenant                 Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder          PurchaseOrder                 @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderVersion   PurchaseOrderVersion?         @relation(fields: [purchaseOrderVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId, purchaseOrderId, createdAt])
  @@index([purchaseOrderVersionId])
}

model PurchaseOrderDeliveryPlan {
  id                     String                          @id @default(uuid()) @db.Uuid
  tenantId               String                          @db.Uuid
  purchaseOrderId        String                          @db.Uuid
  purchaseOrderVersionId String?                         @db.Uuid
  expectedDate           DateTime?
  deliveryAddress        String?
  status                 PurchaseOrderDeliveryPlanStatus @default(PLANNED)
  supplierReference      String?
  notes                  String?
  createdById            String?                         @db.Uuid
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  tenant                 Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder          PurchaseOrder                   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderVersion   PurchaseOrderVersion?           @relation(fields: [purchaseOrderVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId, purchaseOrderId, expectedDate])
  @@index([purchaseOrderVersionId])
}

model Product {
  id                          String                    @id @default(uuid()) @db.Uuid
  tenantId                    String                    @db.Uuid
  categoryId                  String                    @db.Uuid
  manufacturerId              String?                   @db.Uuid
  brandId                     String?                   @db.Uuid
  collectionId                String?                   @db.Uuid
  primaryUnitId               String                    @db.Uuid
  name                        String
  slug                        String
  sku                         String
  supplierSkuPlaceholder      String?
  description                 String?
  material                    String?
  colour                      String?
  shade                       String?
  pattern                     String?
  batchTrackingRequired       Boolean                   @default(false)
  fireRating                  String?
  slipRating                  String?
  acousticRating              String?
  underfloorHeatingCompatible Boolean?
  domesticCommercialClass     String?
  warranty                    String?
  recommendedAdhesive         String?
  recommendedUnderlay         String?
  technicalData               String?
  safetyData                  String?
  lifecycleStatus             ProductLifecycleStatus    @default(ACTIVE)
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  createdById                 String?                   @db.Uuid
  updatedById                 String?                   @db.Uuid
  tenant                      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category                    ProductCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer                Manufacturer?             @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  brand                       Brand?                    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  collection                  ProductCollection?        @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  primaryUnit                 UnitOfMeasure             @relation("ProductPrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: Restrict)
  variants                    ProductVariant[]
  attributeValues             ProductAttributeValue[]
  documents                   ProductDocument[]
  images                      ProductImage[]
  supplierProducts            SupplierProduct[]
  supplierPriceImportRows     SupplierPriceImportRow[]  @relation("SupplierPriceImportMatchedProduct")
  purchaseRequisitionLines    PurchaseRequisitionLine[]
  purchaseOrderLines          PurchaseOrderLine[]
  estimateLines               EstimateLine[]
  materialRequirements        MaterialRequirement[]
  stockBalances               StockBalance[]
  stockReservations           StockReservation[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId, lifecycleStatus, name])
  @@index([tenantId, categoryId, lifecycleStatus])
  @@index([manufacturerId])
  @@index([brandId])
  @@index([collectionId])
  @@index([primaryUnitId])
}

model ProductVariant {
  id                       String                    @id @default(uuid()) @db.Uuid
  tenantId                 String                    @db.Uuid
  productId                String                    @db.Uuid
  unitOfMeasureId          String?                   @db.Uuid
  name                     String
  sku                      String
  colour                   String?
  shade                    String?
  pattern                  String?
  thicknessMm              Decimal?                  @db.Decimal(10, 2)
  wearLayerMm              Decimal?                  @db.Decimal(10, 2)
  rollWidthM               Decimal?                  @db.Decimal(10, 2)
  standardRollLengthM      Decimal?                  @db.Decimal(10, 2)
  tileLengthMm             Decimal?                  @db.Decimal(10, 2)
  tileWidthMm              Decimal?                  @db.Decimal(10, 2)
  packQuantity             Int?
  packCoverageM2           Decimal?                  @db.Decimal(10, 4)
  isDefault                Boolean                   @default(false)
  lifecycleStatus          ProductLifecycleStatus    @default(ACTIVE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  createdById              String?                   @db.Uuid
  updatedById              String?                   @db.Uuid
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product                  Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitOfMeasure            UnitOfMeasure?            @relation(fields: [unitOfMeasureId], references: [id], onDelete: SetNull)
  attributeValues          ProductAttributeValue[]
  documents                ProductDocument[]
  images                   ProductImage[]
  supplierProducts         SupplierProduct[]
  supplierPriceImportRows  SupplierPriceImportRow[]  @relation("SupplierPriceImportMatchedVariant")
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  estimateLines            EstimateLine[]
  materialRequirements     MaterialRequirement[]
  stockBalances            StockBalance[]
  stockReservations        StockReservation[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId, lifecycleStatus])
  @@index([unitOfMeasureId])
}

model ProductAttributeDefinition {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String                    @db.Uuid
  categoryId      String?                   @db.Uuid
  key             String
  name            String
  description     String?
  valueType       ProductAttributeValueType @default(TEXT)
  isRequired      Boolean                   @default(false)
  isFilterable    Boolean                   @default(false)
  sortOrder       Int                       @default(0)
  status          ProductRecordStatus       @default(ACTIVE)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  createdById     String?                   @db.Uuid
  updatedById     String?                   @db.Uuid
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category        ProductCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attributeValues ProductAttributeValue[]

  @@unique([tenantId, key])
  @@index([tenantId, status, sortOrder])
  @@index([categoryId])
}

model ProductAttributeValue {
  id                    String                     @id @default(uuid()) @db.Uuid
  tenantId              String                     @db.Uuid
  productId             String                     @db.Uuid
  variantId             String?                    @db.Uuid
  attributeDefinitionId String                     @db.Uuid
  valueType             ProductAttributeValueType
  valueText             String?
  valueNumber           Decimal?                   @db.Decimal(14, 4)
  valueBoolean          Boolean?
  valueJson             Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  createdById           String?                    @db.Uuid
  updatedById           String?                    @db.Uuid
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product               Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant               ProductVariant?            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId])
  @@index([tenantId, variantId])
  @@index([attributeDefinitionId])
}

model ProductDocument {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  productId   String          @db.Uuid
  variantId   String?         @db.Uuid
  label       String
  storageKey  String
  fileName    String
  contentType String?
  sizeBytes   Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String?         @db.Uuid
  updatedById String?         @db.Uuid
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([tenantId, variantId])
}

model ProductImage {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  productId   String          @db.Uuid
  variantId   String?         @db.Uuid
  altText     String?
  storageKey  String
  fileName    String
  contentType String?
  sizeBytes   Int?
  sortOrder   Int             @default(0)
  isPrimary   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String?         @db.Uuid
  updatedById String?         @db.Uuid
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, sortOrder])
  @@index([tenantId, variantId])
}
